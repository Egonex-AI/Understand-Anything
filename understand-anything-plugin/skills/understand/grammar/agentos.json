  "rules": [
    {
      "predicate": "depends_on",
      "domain": "Unit",
      "range": "Unit",
      "frame": "static-es-module-import",
      "evidenceFrames": {
        "static_json_read": "module-relative-json-read",
        "python_helper_invocation": "static-python-helper",
        "source_launcher_invocation": "source-launcher-invocation"
      },
      "evidence": "A direct relative .mjs import, a literal JSON path passed to node:fs.readFileSync, or a literal Python script path at the start of the argument array passed to the imported boundedProcess runner. JSON reads and Python invocations require pinned source and target bytes and an imported ROOT defined by resolving '..' from the directory of its defining module. The runner must forward the script argument to Python in both direct and sandboxed routes. A source launcher claim requires an explicit sibling shell wrapper that supplies a source-relative --app-root and --launcher-only before forwarding arguments, plus a guarded stdio connection to the literal launcher path. The evidence applies to that invocation."
    },
